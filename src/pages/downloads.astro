---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import { hasContent } from '../lib/sections';
const press = (await getCollection('press')).map((p) => p.data);
const downloadGroups = [
  {
    categoria: 'apresentacao',
    id: 'press-kit',
    eyebrow: 'Conheça a Eutenia',
    titulo: 'Press kit — Apresentação da banda',
    descricao: 'Apresentação da banda para contratantes, festivais e veículos de mídia.',
  },
  {
    categoria: 'tecnico',
    id: 'especificacoes-shows',
    eyebrow: 'Produção técnica',
    titulo: 'Especificações para shows',
    descricao: 'Rider técnico e mapa de palco reunidos em um único PDF para a produção do show.',
  },
  {
    categoria: 'divulgacao',
    id: 'materiais-divulgacao',
    eyebrow: 'Comunicação visual',
    titulo: 'Materiais de divulgação',
    descricao: 'Fotos e logotipos para cartazes, imprensa e divulgação de eventos.',
  },
]
  .map((group) => ({ ...group, files: press.filter((file) => file.categoria === group.categoria) }))
  .filter((group) => group.files.length > 0);

const bundle = press.find((file) => file.categoria === 'pacote');
const eyebrow = 'mb-2 block font-display text-label-sm tracking-widest text-primary uppercase';
const sectionTitle = 'text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md';
---

<BaseLayout
  title="Downloads"
  description="Materiais da Eutenia para contratantes e equipes de produção: press kit, rider técnico, mapa de palco, fotos oficiais e logotipos."
>
  <section class="border-b border-tertiary-container/15 bg-gradient-to-b from-surface-container-low to-void">
    <div class="mx-auto max-w-[1440px] px-margin-sm py-10 md:px-margin-lg md:py-14">
      <span class={eyebrow}>Produção & divulgação</span>
      <h1 class="text-headline-lg-mobile tracking-tight text-on-surface uppercase md:text-headline-lg">
        Materiais para contratantes
      </h1>
      <p class="mt-4 max-w-2xl text-body-md text-tertiary md:text-body-lg">
        Press kit, rider técnico, mapa de palco, fotos e logotipos para a produção e divulgação do
        seu evento.
      </p>
      {bundle?.disponivel && (
        <a
          href={url(bundle.arquivo)}
          download
          data-download-bundle
          class="mt-6 inline-flex items-center justify-center gap-2 bg-crimson px-5 py-3 font-display text-label-lg tracking-wider text-void uppercase red-glow hover:bg-primary-container"
        >
          <span class="material-symbols-outlined" aria-hidden="true">
            folder_zip
          </span>
          Baixar tudo (ZIP){bundle.tamanho && <span class="text-label-sm">· {bundle.tamanho}</span>}
        </a>
      )}
      <nav aria-label="Seções de materiais" class="mt-6 flex flex-wrap gap-2">
        {downloadGroups.map((group) => (
          <a
            href={`#${group.id}`}
            class="border border-tertiary-container/30 px-3 py-2 font-display text-label-md tracking-wide text-on-surface uppercase hover:border-primary hover:text-primary"
          >
            {group.categoria === 'apresentacao'
              ? 'Press kit'
              : group.categoria === 'tecnico'
                ? 'Especificações para shows'
                : 'Fotos & logos'}
          </a>
        ))}
      </nav>
    </div>
  </section>
  {hasContent(press) && (
    <div id="downloads" class="scroll-mt-24" data-press>
      {downloadGroups.map((group) => (
        <section
          id={group.id}
          aria-labelledby={`${group.id}-titulo`}
          class="mx-auto max-w-[1440px] scroll-mt-24 px-margin-sm py-12 md:px-margin-lg md:py-16"
          data-download-group={group.categoria}
        >
          <div class="text-left">
            <div>
              <span class={eyebrow}>{group.eyebrow}</span>
              <h2 id={`${group.id}-titulo`} class={sectionTitle}>
                {group.titulo}
              </h2>
            </div>
            <p class="mt-3 max-w-2xl text-body-sm text-tertiary">{group.descricao}</p>
          </div>
          <ul
            class:list={[
              'mt-8 grid grid-cols-1 gap-4',
              group.files.length === 1 ? 'max-w-xl' : 'sm:grid-cols-2',
              group.files.length > 2 && 'lg:grid-cols-4',
            ]}
          >
            {group.files.map((p) => (
              <li
                class="flex flex-col border border-tertiary-container/20 bg-surface-container-low p-5"
                data-press-file
              >
                <div class="mb-5 flex items-start justify-between gap-3">
                  <span
                    class="material-symbols-outlined text-[28px] text-crimson"
                    aria-hidden="true"
                  >
                    {p.icone}
                  </span>
                  <span
                    class="bg-surface-container-highest px-2 py-0.5 font-display text-label-sm tracking-widest text-tertiary uppercase"
                    data-press-meta
                  >
                    {p.tipo}
                    {p.disponivel && p.tamanho ? ` • ${p.tamanho}` : ''}
                  </span>
                </div>
                <h3 class="font-display text-title-md tracking-wide text-on-surface uppercase">
                  {p.titulo}
                </h3>
                <p class="mt-2 flex-1 text-body-sm text-tertiary">{p.descricao}</p>
                {p.disponivel ? (
                  <a
                    href={url(p.arquivo)}
                    download
                    class="mt-5 flex items-center justify-between border border-tertiary-container/40 px-3 py-2 font-display text-label-md tracking-wider text-on-surface uppercase transition-colors hover:border-crimson hover:text-primary"
                  >
                    <span>
                      Baixar<span class="sr-only"> {p.titulo}</span>
                    </span>
                    <span class="material-symbols-outlined text-base" aria-hidden="true">
                      download
                    </span>
                  </a>
                ) : (
                  <button
                    type="button"
                    disabled
                    class="mt-5 w-full cursor-not-allowed border border-tertiary-container/30 px-3 py-2 text-left font-display text-label-md tracking-wider text-tertiary uppercase"
                  >
                    Em breve
                  </button>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
