---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/ui/PageTitle.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import Stats from '../components/Stats.astro';
import { url } from '../lib/paths';
const press = (await getCollection('press')).map((p) => p.data);
const categories = ['apresentacao', 'tecnico', 'divulgacao'];
const files = press
  .filter((p) => p.categoria !== 'pacote')
  .sort((a, b) => categories.indexOf(a.categoria) - categories.indexOf(b.categoria));
const bundle = press.find((p) => p.categoria === 'pacote');
const photos = (await getCollection('photos')).map((p) => p.data);
const sectionClass =
  'mx-auto max-w-[1440px] scroll-mt-24 px-margin-sm py-12 md:px-margin-lg md:py-16';
const sectionTitle = 'text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md';
const downloadClass =
  'mt-5 inline-flex items-center justify-center gap-2 border border-tertiary-container/40 px-4 py-3 font-display text-label-md tracking-wider text-on-surface uppercase hover:border-crimson hover:text-primary';
---

<BaseLayout
  title="Mídia"
  description="Materiais da Eutenia para shows e divulgação: press kit, rider técnico, mapa de palco, logotipos e fotos para download."
>
  <section class="border-b border-tertiary-container/15 bg-gradient-to-b from-surface-container-low to-void">
    <div class="mx-auto max-w-[1440px] px-margin-sm py-10 md:px-margin-lg md:py-14">
      <PageTitle accent>Mídia</PageTitle>
      <p class="mt-4 max-w-2xl text-body-md text-tertiary md:text-body-lg">
        Materiais para shows e divulgação e fotos da Eutenia.
      </p>
      <nav aria-label="Seções de mídia" class="mt-6 flex flex-wrap gap-2">
        {[
          { id: 'materiais-contratantes', label: 'Materiais para contratantes' },
          { id: 'fotos', label: 'Fotos' },
        ].map((section) => (
          <a
            href={`#${section.id}`}
            class="border border-tertiary-container/30 px-3 py-2 font-display text-label-md tracking-wide text-on-surface uppercase hover:border-primary hover:text-primary"
          >
            {section.label}
          </a>
        ))}
      </nav>
    </div>
  </section>
  <section
    id="materiais-contratantes"
    aria-labelledby="materiais-titulo"
    class={sectionClass}
    data-press
    data-download-group="contratantes"
  >
    <h2 id="materiais-titulo" class={sectionTitle}>
      Materiais para contratantes
    </h2>
    <p class="mt-3 max-w-2xl text-body-sm text-tertiary">
      Press kit, rider técnico, mapa de palco, fotos oficiais e logotipos para a produção e
      divulgação de eventos.
    </p>
    <Stats class="mt-8 border border-tertiary-container/20 bg-surface-container-low p-5 md:p-6" />
    <ul
      class:list={[
        'mt-8 grid grid-cols-1 gap-4',
        files.length === 1 ? 'max-w-xl' : 'sm:grid-cols-2',
        files.length > 2 && 'lg:grid-cols-4',
      ]}
    >
      {files.map((p) => (
        <li
          class="flex flex-col border border-tertiary-container/20 bg-surface-container-low p-5"
          id={p.id}
          data-press-file
        >
          <div class="mb-5 flex items-start justify-between gap-3">
            <span class="material-symbols-outlined text-[28px] text-crimson" aria-hidden="true">
              {p.icone}
            </span>
            <span
              class="bg-surface-container-highest px-2 py-0.5 font-display text-label-sm tracking-widest text-tertiary uppercase"
              data-press-meta
            >
              {p.tipo}
              {p.disponivel && p.tamanho ? ` • ${p.tamanho}` : ''}
            </span>
          </div>
          <h3 class="font-display text-title-md tracking-wide text-on-surface uppercase">
            {p.titulo}
          </h3>
          <p class="mt-2 flex-1 text-body-sm text-tertiary">{p.descricao}</p>
          {p.disponivel ? (
            <a
              href={url(p.arquivo)}
              download
              class="mt-5 flex items-center justify-between border border-tertiary-container/40 px-3 py-2 font-display text-label-md tracking-wider text-on-surface uppercase transition-colors hover:border-crimson hover:text-primary"
            >
              <span>
                Baixar<span class="sr-only"> {p.titulo}</span>
              </span>
              <span class="material-symbols-outlined text-base" aria-hidden="true">
                download
              </span>
            </a>
          ) : (
            <button
              type="button"
              disabled
              class="mt-5 w-full cursor-not-allowed border border-tertiary-container/30 px-3 py-2 text-left font-display text-label-md tracking-wider text-tertiary uppercase"
            >
              Em breve
            </button>
          )}
        </li>
      ))}
    </ul>
    {bundle && (
      <div
        class="mt-6 flex flex-col gap-6 border border-crimson/40 bg-surface-container-low p-6 md:flex-row md:items-center md:justify-between md:p-8"
        data-download-bundle-section
        aria-labelledby="pacote-completo-titulo"
      >
        <div class="flex items-start gap-4">
          <span
            class="material-symbols-outlined shrink-0 text-[32px] text-primary-container"
            aria-hidden="true"
          >
            {bundle.icone}
          </span>
          <div>
            <h3
              id="pacote-completo-titulo"
              class="font-display text-title-md tracking-wide text-on-surface uppercase"
            >
              {bundle.titulo}
            </h3>
            <p class="mt-2 max-w-2xl text-body-sm text-tertiary">{bundle.descricao}</p>
          </div>
        </div>
        {bundle.disponivel ? (
          <a
            href={url(bundle.arquivo)}
            download
            data-download-bundle
            class="inline-flex shrink-0 items-center justify-center gap-2 bg-crimson px-6 py-3 font-display text-label-lg text-void uppercase transition-colors hover:bg-primary-container"
          >
            <span class="material-symbols-outlined text-xl" aria-hidden="true">
              download
            </span>
            Baixar tudo (ZIP){bundle.tamanho && <span>· {bundle.tamanho}</span>}
          </a>
        ) : (
          <button
            type="button"
            disabled
            class="shrink-0 cursor-not-allowed border border-tertiary-container/30 px-6 py-3 font-display text-label-lg text-tertiary uppercase"
          >
            Em breve
          </button>
        )}
      </div>
    )}
  </section>
  <section id="fotos" aria-labelledby="fotos-titulo" class={sectionClass}>
    <h2 id="fotos-titulo" class={sectionTitle}>
      Fotos
    </h2>
    <p class="mt-3 max-w-2xl text-body-sm text-tertiary">
      Imagens da banda para divulgação e imprensa.
    </p>
    {photos.length ? (
      <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-photo-list>
        {photos.map((photo) => (
          <li
            class="overflow-hidden border border-tertiary-container/20 bg-surface-container-low"
            data-photo
          >
            <a
              href={url(photo.arquivo)}
              data-photo-open
              data-photo-preview={url(photo.imagem)}
              data-photo-title={photo.titulo}
              data-photo-credit={photo.credito}
              aria-label={`Ampliar foto: ${photo.titulo}`}
              class="block cursor-zoom-in focus-visible:outline-2 focus-visible:outline-primary focus-visible:-outline-offset-2"
            >
              <img
                src={url(photo.imagem)}
                alt={photo.titulo}
                width="900"
                height="600"
                loading="lazy"
                class="aspect-[3/2] w-full bg-surface-container-lowest object-contain"
              />
            </a>
            <div class="p-5">
              <h3 class="font-display text-title-md uppercase">{photo.titulo}</h3>
              {photo.descricao && <p class="mt-2 text-body-sm text-tertiary">{photo.descricao}</p>}
              {photo.credito && (
                <p class="mt-2 text-body-sm text-tertiary">Foto: {photo.credito}</p>
              )}
              <a href={url(photo.arquivo)} download class={downloadClass}>
                Baixar foto<span class="sr-only"> {photo.titulo}</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 border border-tertiary-container/20 bg-surface-container-low p-6 text-body-md text-tertiary">
        Em breve: fotos da banda para download.
      </p>
    )}
  </section>
  {photos.length > 0 && <PhotoLightbox />}
</BaseLayout>
