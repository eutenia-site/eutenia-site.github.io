---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../content/paginas/privacidade.md';

// PRIV-01: the text lives in src/content/paginas/privacidade.md; the page only styles it.
const prose = [
  'space-y-5 text-body-md text-tertiary md:text-body-lg',
  '[&_h2]:pt-6 [&_h2]:font-display [&_h2]:text-headline-sm [&_h2]:tracking-wide [&_h2]:text-on-surface [&_h2]:uppercase',
  '[&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6 [&_li]:marker:text-crimson',
  '[&_a]:text-primary [&_a]:underline [&_a:hover]:text-on-surface [&_strong]:text-on-surface',
];
---

<BaseLayout
  title="Política de Privacidade"
  description="Política de Privacidade do site da Eutenia: dados coletados pelos formulários, finalidade, compartilhamento e como falar com a banda."
>
  <section class="relative overflow-hidden border-b border-tertiary-container/15 bg-gradient-to-b from-surface-container-low to-void">
    <div class="pointer-events-none absolute -top-24 left-0 h-80 w-[600px] bg-crimson/10 blur-[120px]"></div>
    <div class="relative mx-auto max-w-[1440px] px-margin-sm pt-10 pb-8 md:px-margin-lg md:pt-16 md:pb-12">
      <span class="mb-3 flex items-center gap-2 font-display text-label-sm tracking-widest text-primary uppercase">
        <span class="h-2 w-2 bg-crimson" aria-hidden="true"></span>
        Seus dados
      </span>
      <h1 class="text-display-xl-mobile tracking-tight text-on-surface uppercase md:text-headline-lg">
        {frontmatter.titulo}
      </h1>
      <p
        class="mt-3 font-display text-label-md tracking-widest text-tertiary uppercase"
        data-updated
      >
        Última atualização: {frontmatter.atualizadoEm}
      </p>
    </div>
  </section>

  <article
    class:list={['mx-auto max-w-3xl px-margin-sm py-10 md:px-margin-lg md:py-16', prose]}
    data-privacy
  >
    <Content />
  </article>
</BaseLayout>
