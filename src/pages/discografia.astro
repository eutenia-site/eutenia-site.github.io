---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import LazyYouTube from '../components/LazyYouTube.astro';
import CoverTile from '../components/ui/CoverTile.astro';
import SpotifyEmbed from '../components/ui/SpotifyEmbed.astro';
import BrandIcon from '../components/ui/BrandIcon.astro';
import { latestReleases, releaseKind, visibleFilters, type DiscFilter } from '../lib/catalog';
import { formatDuration, formatPrice, releaseTypeLabel, trackCount } from '../lib/format';
import { url } from '../lib/paths';
import { hasContent } from '../lib/sections';

const site = (await getEntry('site', 'site'))!.data;
const releases = (await getCollection('releases')).map((r) => r.data);
const videos = (await getCollection('videos')).map((v) => v.data);
const press = (await getCollection('press')).map((p) => p.data);
const products = (await getCollection('products')).map((p) => p.data);
// Mobile merch promo (mobile-discografia.png): the first product marked destaque.
const promo = products.find((p) => p.destaque);
const promoBuy = promo ? promo.url || site.lojaUrl : '';

// DISC-03: newest first.
const catalog = latestReleases(releases, releases.length);
const featured = releases.find((r) => r.destaque) ?? catalog[0];
// DISC-07: only official clips, newest first.
const clips = videos.filter((v) => v.oficial).sort((a, b) => b.data.getTime() - a.data.getTime());

const FILTERS: { value: DiscFilter; label: string }[] = [
  { value: 'todos', label: 'Todos' },
  { value: 'albuns', label: 'Álbuns & EPs' },
  { value: 'singles', label: 'Singles' },
  { value: 'videoclipes', label: 'Videoclipes' },
  { value: 'ao-vivo', label: 'Ao vivo' },
];
const itemKeys = [
  ...catalog.map((r) => releaseKind(r.tipo)),
  ...(clips.length ? ['videoclipes'] : []),
];
const shown = visibleFilters(
  FILTERS.map((f) => f.value),
  itemKeys,
);
const filters = FILTERS.filter((f) => shown.includes(f.value));

const PLATFORMS = [
  { key: 'spotify', label: 'Spotify' },
  { key: 'appleMusic', label: 'Apple Music' },
  { key: 'deezer', label: 'Deezer' },
  { key: 'tidal', label: 'Tidal' },
  { key: 'youtubeMusic', label: 'YouTube Music' },
] as const;

const year = (d: Date) => d.getUTCFullYear();
const totalSeconds = featured ? featured.faixas.reduce((s, f) => s + f.duracaoSeg, 0) : 0;
const totalLabel = `${Math.floor(totalSeconds / 60)} min ${totalSeconds % 60} seg`;
const streaming = featured
  ? PLATFORMS.filter((p) => featured.links[p.key]).map((p) => ({
      ...p,
      href: featured.links[p.key]!,
    }))
  : [];
const listenUrl = (r: (typeof releases)[number]) =>
  r.links.spotify ?? r.links.deezer ?? r.links.appleMusic ?? r.links.tidal ?? r.links.youtubeMusic;
const sectionTitle = 'flex items-center gap-3';
const marker = 'inline-block h-6 w-2.5 shrink-0 bg-primary-container';
---

<BaseLayout
  title="Discografia & Mídia"
  description="Discografia completa da Eutenia: álbum Pandora, singles e EPs com faixas, capas e plataformas, além dos videoclipes oficiais."
>
  <section class="relative mx-auto max-w-[1440px] overflow-hidden border-b border-tertiary-container/15 px-margin-sm pt-8 pb-6 md:px-margin-lg md:pt-12 md:pb-10">
    <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-pill bg-primary-container/10 blur-3xl"></div>
    <div class="relative z-10">
      <span class="mb-3 inline-flex items-center gap-2 border border-outline-variant bg-surface-container-high px-3 py-1 font-display text-label-sm tracking-widest text-primary uppercase">
        <span class="h-1.5 w-1.5 rounded-pill bg-primary-container motion-safe:animate-pulse"></span>
        Catálogo oficial de áudio & vídeo
      </span>
      <h1 class="text-display-xl-mobile tracking-wide text-on-surface uppercase md:text-headline-lg">
        Discografia & Mídia
      </h1>
      <p class="mt-2 max-w-2xl text-body-md text-tertiary md:text-body-lg">
        Álbuns, EPs, Singles e Videoclipes Oficiais da Eutenia.
      </p>
    </div>
    <FilterBar
      target="[data-disc-list]"
      rule="kind"
      filters={filters}
      label="Filtrar por tipo"
      class="relative z-10 mt-6 border-b-0 pb-0 md:mt-10"
    />
  </section>

  {featured && (
    <section
      aria-labelledby="destaque-titulo"
      class="mx-auto max-w-[1440px] px-margin-sm py-10 md:px-margin-lg md:py-16"
      data-featured
    >
      <div class="mb-6 flex items-center justify-between gap-4 md:mb-8">
        <div class={sectionTitle}>
          <span class={marker} aria-hidden="true" />
          <h2
            id="destaque-titulo"
            class="text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md"
          >
            Lançamento em destaque
          </h2>
        </div>
        <span class="rounded-pill border border-primary/40 bg-primary/10 px-3 py-1 font-display text-label-sm tracking-wider text-primary uppercase">
          {releaseTypeLabel(featured.tipo)} • {year(featured.data)}
        </span>
      </div>
      <div class="relative grid grid-cols-1 overflow-hidden border border-tertiary-container/20 bg-surface-container-low lg:grid-cols-12">
        <div class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 bg-primary-container/15 blur-3xl" />
        <div
          class="relative flex items-start justify-center border-b border-tertiary-container/15 bg-surface-container-lowest p-4 md:p-8 lg:col-span-5 lg:border-r lg:border-b-0 lg:p-12"
          data-featured-cover
        >
          <div class="relative aspect-square w-full max-w-[420px] overflow-hidden border border-outline-variant/30">
            <CoverTile titulo={featured.titulo} capa={featured.capa} width={420} loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80" />
            <div class="absolute right-4 bottom-4 left-4 flex items-end justify-between gap-3">
              <div class="min-w-0">
                <p class="font-display text-label-sm tracking-widest text-primary uppercase">
                  {releaseTypeLabel(featured.tipo)}
                </p>
                <p class="font-display text-headline-sm font-bold text-on-surface uppercase">
                  {featured.titulo}
                </p>
              </div>
              {featured.links.spotify && (
                <a
                  href={featured.links.spotify}
                  target="_blank"
                  rel="noopener"
                  data-featured-play
                  aria-label={`Ouvir ${featured.titulo} no Spotify (abre em nova aba)`}
                  class="flex h-12 w-12 shrink-0 items-center justify-center bg-crimson text-void red-glow transition-transform hover:scale-105"
                >
                  <span
                    class="material-symbols-outlined text-[28px]"
                    style="font-variation-settings: 'FILL' 1"
                    aria-hidden="true"
                  >
                    play_arrow
                  </span>
                </a>
              )}
            </div>
          </div>
        </div>
        <div class="relative z-10 flex flex-col justify-between p-4 md:p-8 lg:col-span-7 lg:p-12">
          <div>
            <div class="border-b border-tertiary-container/15 pb-6">
              <span class="font-display text-label-md tracking-widest text-tertiary uppercase">
                {releaseTypeLabel(featured.tipo)} • {trackCount(featured.faixas.length)} •{' '}
                {totalLabel}
              </span>
              <h3 class="mt-1 text-headline-sm font-bold text-on-surface uppercase md:text-headline-md">
                Eutenia — {featured.titulo}
              </h3>
              {featured.descricao && (
                <p class="mt-1 text-body-md text-tertiary">{featured.descricao}</p>
              )}
              {hasContent(press) && (
                <a
                  href={url('/contato/#press-kit')}
                  data-press-kit
                  class="mt-4 inline-flex items-center gap-2 border border-tertiary-container/40 px-4 py-2 font-display text-label-md tracking-wider text-on-surface uppercase transition-colors hover:border-primary hover:text-primary"
                >
                  <span class="material-symbols-outlined text-base" aria-hidden="true">
                    download
                  </span>
                  Press kit
                </a>
              )}
            </div>
            <ol class="mt-6 space-y-2" data-tracklist>
              {featured.faixas.map((f, i) => (
                <li class="flex items-center justify-between gap-4 border border-tertiary-container/15 bg-surface-container-low p-3.5 transition-colors hover:border-outline hover:bg-surface-container">
                  <div class="flex min-w-0 items-center gap-4">
                    <span class="w-7 shrink-0 text-center font-display text-headline-sm text-tertiary-container">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="truncate font-display text-title-md text-on-surface" data-track>
                      {f.titulo}
                    </span>
                  </div>
                  <span class="shrink-0 font-mono text-label-md text-tertiary" data-duration>
                    {formatDuration(f.duracaoSeg)}
                  </span>
                </li>
              ))}
            </ol>
            {hasContent(featured.letraPrevia) && (
              <details
                open
                data-lyrics
                class="group/lyrics mt-4 border border-outline-variant/40 bg-surface-container-lowest p-4"
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-display text-label-sm tracking-wider uppercase [&::-webkit-details-marker]:hidden">
                  <span class="flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">
                      format_quote
                    </span>
                    Prévia da letra: "{featured.titulo}"
                  </span>
                  <span
                    class="flex items-center gap-1 text-tertiary transition-colors hover:text-primary"
                    data-lyrics-toggle
                  >
                    <span class="hidden group-open/lyrics:inline">Recolher</span>
                    <span class="group-open/lyrics:hidden">Expandir</span>
                    <span
                      class="material-symbols-outlined text-base transition-transform group-open/lyrics:rotate-180"
                      aria-hidden="true"
                    >
                      expand_more
                    </span>
                  </span>
                </summary>
                <blockquote class="mt-2 border-l-2 border-primary-container py-1 pl-3 text-body-sm whitespace-pre-line text-tertiary italic">
                  {featured.letraPrevia}
                </blockquote>
              </details>
            )}
          </div>
          {hasContent(streaming) && (
            <div class="mt-8 border-t border-tertiary-container/15 pt-6" data-streaming>
              <span class="mb-3 block font-display text-label-sm tracking-widest text-tertiary uppercase">
                Ouça nas plataformas de streaming:
              </span>
              <ul class="grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap sm:items-center">
                {streaming.map((p) => (
                  <li>
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener"
                      class="flex items-center justify-center gap-2 border border-tertiary-container/25 bg-surface-container px-3.5 py-2 font-display text-label-md text-on-surface uppercase transition-all hover:border-primary hover:text-primary"
                    >
                      <BrandIcon name={p.key} size={18} />
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
      {featured.spotifyEmbed && (
        <div class="mt-4 border border-tertiary-container/25 bg-surface-container/95 p-3 shadow-flyout">
          <SpotifyEmbed
            src={featured.spotifyEmbed}
            title={`Player do Spotify: ${featured.titulo}`}
            height={80}
          />
        </div>
      )}
    </section>
  )}

  {hasContent(catalog) && (
    <section
      aria-labelledby="catalogo-titulo"
      class="mx-auto max-w-[1440px] px-margin-sm py-8 md:px-margin-lg md:py-12"
      data-filter-group
    >
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-tertiary-container/15 pb-4 md:mb-8">
        <div class={sectionTitle}>
          <span class={marker} aria-hidden="true" />
          <h2
            id="catalogo-titulo"
            class="text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md"
          >
            Catálogo completo de lançamentos
          </h2>
        </div>
        <span class="shrink-0 font-display text-label-sm tracking-widest text-tertiary uppercase">
          {catalog.length} títulos
        </span>
      </div>
      <ul
        data-disc-list
        data-catalog
        class="grid grid-cols-2 gap-3 md:grid-cols-2 md:gap-8 lg:grid-cols-3"
      >
        {catalog.map((r) => {
          const listen = listenUrl(r);
          return (
            <li
              id={r.id}
              data-kind={releaseKind(r.tipo)}
              data-release
              class="group flex scroll-mt-24 flex-col justify-between border border-tertiary-container/15 bg-surface-container-low transition-all duration-300 hover:border-primary-container/60"
            >
              <div>
                <div class="relative overflow-hidden bg-surface-container-lowest">
                  <CoverTile
                    titulo={r.titulo}
                    capa={r.capa}
                    width={400}
                    class="transition-transform duration-500 group-hover:scale-105"
                  />
                  <span class="absolute top-3 right-3 hidden border border-outline-variant bg-surface-container-lowest/90 px-2.5 py-1 font-display text-label-sm text-primary uppercase md:block">
                    {year(r.data)}
                  </span>
                  <span
                    data-mobile-type
                    class="absolute top-2 left-2 bg-crimson px-1.5 py-0.5 font-display text-label-sm tracking-widest text-void uppercase md:hidden"
                  >
                    {releaseTypeLabel(r.tipo)}
                  </span>
                  {listen && (
                    <a
                      href={listen}
                      target="_blank"
                      rel="noopener"
                      data-mobile-play
                      class="absolute right-2 bottom-2 flex h-9 w-9 items-center justify-center rounded-full bg-crimson text-void red-glow md:hidden"
                    >
                      <span
                        class="material-symbols-outlined text-xl"
                        style="font-variation-settings: 'FILL' 1"
                        aria-hidden="true"
                      >
                        play_arrow
                      </span>
                      <span class="sr-only">Ouvir {r.titulo} (abre em nova aba)</span>
                    </a>
                  )}
                </div>
                <div class="p-3 md:p-6">
                  <div class="mb-2 hidden flex-wrap items-center gap-2 md:flex">
                    <span class="bg-surface-container px-2 py-0.5 font-display text-label-sm text-tertiary uppercase">
                      {releaseTypeLabel(r.tipo)}
                    </span>
                    <span class="text-xs text-outline" aria-hidden="true">
                      •
                    </span>
                    <span class="font-display text-label-sm text-secondary uppercase">
                      {trackCount(r.faixas.length)}
                    </span>
                  </div>
                  <h3
                    class="text-title-md font-bold text-on-surface uppercase transition-colors group-hover:text-primary max-md:line-clamp-2 md:text-headline-sm"
                    title={r.titulo}
                  >
                    {r.titulo}
                  </h3>
                  <p class="mt-1 flex items-center justify-between gap-2 font-display text-label-sm text-tertiary uppercase md:hidden">
                    <span>{year(r.data)}</span>
                    <span>{trackCount(r.faixas.length)}</span>
                  </p>
                  {r.descricao && (
                    <p class="mt-2 hidden text-body-sm text-tertiary md:block">{r.descricao}</p>
                  )}
                </div>
              </div>
              {listen && (
                <div class="hidden items-center justify-end border-t border-tertiary-container/10 p-6 pt-4 md:flex">
                  <a
                    href={listen}
                    target="_blank"
                    rel="noopener"
                    class="flex items-center gap-1.5 border border-tertiary-container/20 bg-surface-container px-4 py-2 font-display text-label-sm tracking-wider text-on-surface uppercase transition-colors hover:bg-primary-container hover:text-on-primary"
                  >
                    <span class="material-symbols-outlined text-sm" aria-hidden="true">
                      queue_music
                    </span>
                    Ouvir / Tracklist<span class="sr-only"> {r.titulo} (abre em nova aba)</span>
                  </a>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {hasContent(clips) && (
    <section
      aria-labelledby="videos-titulo"
      class="mx-auto max-w-[1440px] px-margin-sm py-8 md:px-margin-lg md:py-12"
      data-filter-group
    >
      <div class="mb-6 flex flex-col justify-between gap-3 border-b border-tertiary-container/15 pb-4 md:mb-8 md:flex-row md:items-end">
        <div>
          <span class="mb-1 block font-display text-label-sm tracking-widest text-primary uppercase md:hidden">
            Produção audiovisual
          </span>
          <div class={sectionTitle}>
            <span class:list={[marker, 'hidden md:inline-block']} aria-hidden="true" />
            <h2
              id="videos-titulo"
              class="text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md"
            >
              Videoclipes oficiais
            </h2>
          </div>
        </div>
        <a
          href={site.social.youtube}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-1.5 self-start font-display text-label-md tracking-wider text-primary uppercase transition-colors hover:text-on-surface md:self-auto"
        >
          <BrandIcon name="youtube" size={20} />
          Inscrever-se no canal oficial
        </a>
      </div>
      <ul
        data-disc-list
        data-videos
        class="grid grid-cols-1 gap-6 max-md:grid-cols-2 max-md:gap-3 md:grid-cols-2 lg:grid-cols-4"
      >
        {clips.map((v) => (
          <li
            data-kind="videoclipes"
            data-video
            class="group border border-tertiary-container/15 bg-surface-container-low transition-all hover:border-primary-container"
          >
            <LazyYouTube id={v.id} titulo={v.titulo} class="border-0" />
            <div class="flex items-start justify-between gap-3 p-4 max-md:gap-1 max-md:p-3">
              <div class="min-w-0">
                <h3
                  class="line-clamp-2 font-display text-title-md text-on-surface normal-case transition-colors group-hover:text-primary"
                  data-video-title
                  title={v.titulo}
                >
                  {v.titulo}
                </h3>
                <p class="mt-2 text-body-sm text-tertiary">{year(v.data)}</p>
              </div>
              <button
                type="button"
                hidden
                data-share
                data-share-url={`https://www.youtube.com/watch?v=${v.id}`}
                data-share-title={v.titulo}
                class="flex h-9 w-9 shrink-0 items-center justify-center text-tertiary transition-colors hover:text-primary md:hidden"
              >
                <span class="material-symbols-outlined text-xl" aria-hidden="true">
                  share
                </span>
                <span class="sr-only">Compartilhar {v.titulo}</span>
              </button>
              <span role="status" class="sr-only" data-share-status></span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {promo && (
    <section
      aria-labelledby="merch-promo-titulo"
      class="mx-auto max-w-[1440px] px-margin-sm pb-10 md:hidden"
      data-merch-promo
    >
      <div class="flex items-center gap-4 border border-primary/40 bg-surface-container-low p-4 red-glow-subtle">
        <img
          src={url(promo.imagem)}
          alt=""
          width="80"
          height="100"
          loading="lazy"
          class="h-20 w-16 shrink-0 object-cover"
        />
        <div class="min-w-0 flex-1">
          <span class="block font-display text-label-sm tracking-widest text-primary uppercase">
            Merch oficial
          </span>
          <h2
            id="merch-promo-titulo"
            class="truncate font-display text-title-md font-bold text-on-surface uppercase"
            title={promo.nome}
          >
            {promo.nome}
          </h2>
          <p class="font-display text-title-md text-primary">{formatPrice(promo.precoCentavos)}</p>
        </div>
        {promoBuy ? (
          <a
            href={promoBuy}
            target="_blank"
            rel="noopener"
            data-merch-action
            class="shrink-0 bg-crimson px-4 py-2.5 font-display text-label-md tracking-wider text-void uppercase red-glow"
          >
            Comprar<span class="sr-only"> {promo.nome} (abre em nova aba)</span>
          </a>
        ) : (
          <button
            type="button"
            disabled
            data-merch-action
            class="shrink-0 cursor-not-allowed border border-tertiary-container/40 px-4 py-2.5 font-display text-label-md tracking-wider text-tertiary uppercase"
          >
            Em breve
          </button>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Share a clip: the system share sheet where there is one, else copy the link.
  const nav = navigator as Navigator & { share?: (d: ShareData) => Promise<void> };
  const canCopy = Boolean(navigator.clipboard?.writeText);
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    if (!nav.share && !canCopy) return;
    btn.hidden = false;
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-share-status]');
    btn.addEventListener('click', async () => {
      const url = btn.dataset.shareUrl ?? '';
      const title = btn.dataset.shareTitle ?? '';
      try {
        if (nav.share) {
          await nav.share({ title, url });
        } else {
          await navigator.clipboard.writeText(url);
          if (status) status.textContent = 'Link copiado';
        }
      } catch {
        /* share sheet dismissed or clipboard denied: nothing to report */
      }
    });
  });
</script>
