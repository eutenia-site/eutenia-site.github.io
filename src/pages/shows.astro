---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ShowTabList from '../components/ShowTabList.astro';
import ShowTabs from '../components/ShowTabs.astro';
import { formatPrice } from '../lib/format';
import { url } from '../lib/paths';
import { hasContent } from '../lib/sections';

const site = (await getEntry('site', 'site'))!.data;
const shows = (await getCollection('shows')).map((s) => s.data);
const vip = (await getCollection('vip')).map((v) => v.data)[0];
const press = (await getCollection('press')).map((p) => p.data);
const rider = press.find((p) => p.id === 'rider-tecnico' && p.disponivel);
const pressKit = press.find((file) => file.categoria === 'apresentacao' && file.disponivel);
const hasTechnicalDownloads = press.some((file) => file.categoria === 'tecnico');

const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
const CONTACTS = [
  {
    icon: 'event_available',
    title: 'Booking & Turnês',
    text: 'Atendimento a promotores, rider técnico e orçamento de datas.',
    subject: 'Booking & Shows',
  },
];
const hasAside = hasContent(vip) || Boolean(site.votoCidadeEndpoint);
---

<BaseLayout
  title="Turnê & Shows"
  description="Agenda de shows da Eutenia: próximas datas, ingressos, festivais, shows passados e contratação da banda para o seu evento."
>
  <section class="relative overflow-hidden border-b border-tertiary-container/15 bg-gradient-to-b from-surface-container-low to-void">
    <div class="pointer-events-none absolute -top-24 left-0 h-80 w-[600px] bg-crimson/10 blur-[120px]"></div>
    <div class="relative mx-auto max-w-[1440px] px-margin-sm pt-8 pb-8 md:px-margin-lg md:pt-14">
      <span class="mb-3 flex items-center gap-2 font-display text-label-sm tracking-widest text-primary uppercase">
        <span class="h-2 w-2 bg-crimson" aria-hidden="true"></span>
        Agenda oficial // Brasil
      </span>
      <h1 class="text-display-xl-mobile tracking-tight text-on-surface uppercase md:text-display-xl">
        Turnê & Shows
      </h1>
      <p class="mt-3 max-w-xl text-body-md text-tertiary md:text-body-lg">
        Datas da turnê e festivais. A energia do metal moderno da Eutenia ao vivo nos palcos do
        país.
      </p>
      <ShowTabList class="mt-8 md:mt-10" />
    </div>
  </section>

  <div
    class:list={[
      'mx-auto grid max-w-[1440px] grid-cols-1 gap-10 px-margin-sm py-8 md:px-margin-lg md:py-12',
      hasAside && 'lg:grid-cols-12',
    ]}
  >
    <div class:list={[hasAside && 'lg:col-span-8']}>
      <ShowTabs shows={shows} instagram={site.social.instagram} youtube={site.social.youtube} />
    </div>

    {hasAside && (
      <aside class="space-y-6 lg:col-span-4" aria-label="Experiências e pedidos">
        {hasContent(vip) && (
          <section
            data-vip
            aria-labelledby="vip-titulo"
            class="overflow-hidden border border-crimson/40 bg-gradient-to-b from-crimson/10 to-surface-container-low red-glow-subtle"
          >
            <div class="relative md:hidden">
              <img
                src={url('placeholders/fotos/shows-bastidores.jpg')}
                alt=""
                width="600"
                height="300"
                loading="lazy"
                class="aspect-[2/1] w-full object-cover"
              />
              <span class="absolute top-3 left-3 bg-crimson px-2 py-0.5 font-display text-label-sm tracking-widest text-void uppercase">
                Experiência exclusiva
              </span>
            </div>
            <div class="space-y-5 p-5 md:p-6">
              <div class="hidden items-center justify-between gap-3 md:flex">
                <span class="bg-crimson px-2 py-0.5 font-display text-label-sm tracking-widest text-void uppercase">
                  Experiência exclusiva
                </span>
                {vip.selo && (
                  <span class="font-display text-label-sm tracking-widest text-primary uppercase">
                    {vip.selo}
                  </span>
                )}
              </div>
              <h2
                id="vip-titulo"
                class="text-headline-sm tracking-wide text-on-surface uppercase md:text-headline-md"
              >
                {vip.titulo}
              </h2>
              <p class="text-body-sm text-tertiary">{vip.descricao}</p>
              <img
                src={url('placeholders/fotos/shows-bastidores.jpg')}
                alt=""
                width="600"
                height="340"
                loading="lazy"
                class="hidden aspect-video w-full object-cover laser-border md:block"
              />
              <ul class="space-y-3">
                {vip.beneficios.map((b) => (
                  <li class="flex items-start gap-2.5 text-body-sm text-tertiary">
                    <span
                      class="material-symbols-outlined text-base text-crimson"
                      aria-hidden="true"
                    >
                      verified
                    </span>
                    <span>
                      <strong class="font-semibold text-on-surface">{b.titulo}:</strong>{' '}
                      {b.descricao}
                    </span>
                  </li>
                ))}
              </ul>
              <div
                data-vip-mobile-buy
                class="flex items-center justify-between gap-3 border-t border-tertiary-container/15 pt-4 md:hidden"
              >
                <div>
                  <span class="block font-display text-label-sm tracking-widest text-tertiary uppercase">
                    Valor adicional
                  </span>
                  <span class="font-display text-headline-sm text-on-surface">
                    {formatPrice(vip.valorCentavos)}
                  </span>
                </div>
                <a
                  href={vip.url}
                  target="_blank"
                  rel="noopener"
                  class="bg-crimson px-4 py-3 text-center font-display text-label-md tracking-wider text-void uppercase red-glow"
                >
                  Garantir upgrade VIP<span class="sr-only"> (abre em nova aba)</span>
                </a>
              </div>
              <div class="hidden items-end justify-between gap-3 border-t border-tertiary-container/15 pt-4 md:flex">
                <span class="font-display text-label-sm tracking-widest text-tertiary uppercase">
                  Valor adicional
                </span>
                <span class="font-display text-headline-sm text-on-surface">
                  {formatPrice(vip.valorCentavos)}
                </span>
              </div>
              <a
                href={vip.url}
                target="_blank"
                rel="noopener"
                class="hidden w-full items-center justify-center gap-2 border border-silver/40 md:flex bg-surface-container-high px-6 py-3 font-display text-label-lg tracking-wider text-on-surface uppercase transition-colors hover:border-crimson hover:bg-crimson hover:text-void"
              >
                Garantir upgrade VIP
                <span class="material-symbols-outlined text-base" aria-hidden="true">
                  stars
                </span>
              </a>
              {vip.observacao && (
                <p class="text-center text-body-sm text-tertiary">{vip.observacao}</p>
              )}
            </div>
          </section>
        )}

        {site.votoCidadeEndpoint && (
          <section
            data-voto
            aria-labelledby="voto-titulo"
            class="hidden border border-tertiary-container/20 bg-surface-container-low p-5 md:block"
          >
            <div class="mb-4 flex items-start gap-3">
              <span class="material-symbols-outlined text-crimson" aria-hidden="true">
                campaign
              </span>
              <div>
                <h2
                  id="voto-titulo"
                  class="font-display text-title-md tracking-wide text-on-surface uppercase"
                >
                  Sua cidade fora da rota?
                </h2>
                <p class="text-body-sm text-tertiary">
                  Vote na sua cidade para as próximas datas da turnê.
                </p>
              </div>
            </div>
            <form action={site.votoCidadeEndpoint} method="post" class="flex gap-2">
              <label for="voto-cidade" class="sr-only">
                Sua cidade/UF
              </label>
              <input
                id="voto-cidade"
                name="cidade"
                required
                placeholder="Digite sua cidade/UF..."
                class="min-w-0 flex-1 border border-tertiary-container/30 bg-surface-container-lowest px-3 py-2 text-body-sm text-on-surface placeholder:text-tertiary-container focus:border-primary"
              />
              <button
                type="submit"
                class="bg-surface-container-highest px-4 py-2 font-display text-label-md tracking-wider text-on-surface uppercase transition-colors hover:bg-crimson hover:text-void"
              >
                Votar
              </button>
            </form>
          </section>
        )}
      </aside>
    )}
  </div>

  <section
    id="contratar"
    aria-labelledby="contratar-titulo"
    class="border-t border-tertiary-container/15 bg-surface-container-lowest"
  >
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-10 px-margin-sm py-12 md:px-margin-lg md:py-16 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-5">
        <span class="flex items-center gap-2 font-display text-label-sm tracking-widest text-primary uppercase">
          <span class="h-2 w-2 bg-crimson" aria-hidden="true"></span>
          Booking & Shows
        </span>
        <h2
          id="contratar-titulo"
          class="text-headline-lg-mobile tracking-tight text-on-surface uppercase md:text-headline-lg"
        >
          Contratar a banda
        </h2>
        <p class="text-body-md text-tertiary">
          Canal direto para produtores de eventos, festivais e casas de espetáculo.
        </p>
        <ul class="space-y-4">
          {CONTACTS.map((c) => (
            <li class="flex items-start gap-4 border border-tertiary-container/20 bg-surface-container-low p-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-surface-container-highest text-primary">
                <span class="material-symbols-outlined" aria-hidden="true">
                  {c.icon}
                </span>
              </span>
              <div class="min-w-0">
                <h3 class="font-display text-label-sm tracking-widest text-tertiary uppercase">
                  {c.title}
                </h3>
                <a
                  href={mailto(c.subject)}
                  class="font-display text-title-md break-all text-on-surface transition-colors hover:text-primary max-md:inline-flex max-md:items-center md:text-headline-sm"
                >
                  {site.email}
                </a>
                <p class="mt-1 text-body-sm text-tertiary">{c.text}</p>
              </div>
            </li>
          ))}
        </ul>
        {[
          { file: pressKit, title: 'Press kit', label: 'Baixar press kit' },
          { file: rider, title: 'Rider Técnico', label: 'Baixar rider' },
        ].map(
          ({ file, title, label }) =>
            file && (
              <div class="flex items-center justify-between gap-4 border border-tertiary-container/20 bg-surface-container-low p-4">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="material-symbols-outlined shrink-0 text-tertiary" aria-hidden="true">
                    description
                  </span>
                  <div>
                    <p class="font-display text-label-md tracking-wider text-on-surface uppercase">
                      {title}
                    </p>
                    <p class="text-body-sm text-tertiary">
                      {file.tipo} • {file.tamanho}
                    </p>
                  </div>
                </div>
                <a
                  href={url(file.arquivo)}
                  download
                  data-press-kit={file.id === 'press-kit' ? '' : undefined}
                  class="shrink-0 border border-tertiary-container/40 bg-surface-container-high px-4 py-2 font-display text-label-sm tracking-wider text-on-surface uppercase transition-colors hover:border-crimson"
                >
                  {label}
                </a>
              </div>
            ),
        )}
        <div class="flex flex-wrap gap-3">
          {hasTechnicalDownloads && (
            <a
              href={url('/downloads/#especificacoes-shows')}
              data-technical-downloads
              class="inline-flex items-center gap-2 border border-tertiary-container/40 bg-surface-container-high px-4 py-3 font-display text-label-md tracking-wider text-on-surface uppercase transition-colors hover:border-primary hover:text-primary"
            >
              <span class="material-symbols-outlined text-base" aria-hidden="true">
                folder_open
              </span>
              Especificações para shows
              <span class="material-symbols-outlined text-base" aria-hidden="true">
                arrow_forward
              </span>
            </a>
          )}
        </div>
      </div>

      <div class="border border-tertiary-container/20 bg-surface-container-low p-5 md:p-8 lg:col-span-7">
        <h3 class="font-display text-headline-sm tracking-wide text-on-surface uppercase">
          Formulário para promotores & curadoria
        </h3>
        <p class="mt-1 mb-6 text-body-sm text-tertiary">
          Preencha os dados da sua praça ou festival para receber retorno comercial.
        </p>
        <ContactForm
          variant="booking"
          id="booking"
          email={site.email}
          endpoint={site.formEndpoint}
        />
      </div>
    </div>
  </section>
</BaseLayout>
