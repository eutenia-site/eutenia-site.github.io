---
interface Props {
  /** alert: crimson (últimos ingressos, novo); muted: esgotado; neutral: metadata. */
  tone?: 'alert' | 'muted' | 'neutral';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
const tones = {
  alert: 'border-crimson bg-crimson/15 text-primary',
  muted: 'border-chrome/30 bg-chrome/15 text-tertiary',
  neutral: 'border-chrome/40 bg-transparent text-silver',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-pill border px-3 py-1 font-display text-label-sm tracking-widest whitespace-nowrap uppercase',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
