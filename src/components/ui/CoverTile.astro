---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  titulo: string;
  capa?: ImageMetadata | string;
  /** Rendered width in px for the optimized image. */
  width?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { titulo, capa, width = 400, loading = 'lazy', class: className } = Astro.props;
// Dev and fixture builds can regenerate the content image map with different paths.
// Import unresolved JSON covers directly so the Image component always gets metadata.
const covers = import.meta.glob<ImageMetadata>(
  '../../assets/capas/*.{avif,gif,jpeg,jpg,png,svg,tiff,webp}',
  { import: 'default' },
);
let cover = typeof capa === 'string' ? undefined : capa;
if (typeof capa === 'string') {
  const importCover = covers[`../../assets/capas/${capa.split(/[\\/]/).pop()}`];
  if (!importCover) throw new Error(`Capa não encontrada: ${capa}`);
  cover = await importCover();
}
---

{cover ? (
  <Image
    src={cover}
    alt={`Capa de ${titulo}`}
    width={width}
    height={width}
    loading={loading}
    class:list={['aspect-square w-full object-cover', className]}
  />
) : (
  <div
    role="img"
    aria-label={`${titulo} (sem capa)`}
    data-cover-fallback
    class:list={[
      'laser-border flex aspect-square w-full items-center justify-center gap-1.5 bg-surface-container-highest',
      className,
    ]}
  >
    <span class="font-display text-headline-sm font-bold tracking-widest text-on-surface uppercase">
      Eutenia
    </span>
    <span class="h-1.5 w-1.5 bg-crimson" aria-hidden="true" />
  </div>
)}
