---
interface Props {
  eyebrow?: string;
  title: string;
  /** Optional "see all" link on the right. */
  href?: string;
  linkLabel?: string;
  /** id for the heading, so the section can use aria-labelledby. */
  id?: string;
  level?: 'h1' | 'h2';
}

const { eyebrow, title, href, linkLabel, id, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="flex flex-row items-end justify-between gap-4 border-b border-tertiary-container/15 pb-4">
  <div class="min-w-0">
    {eyebrow && (
      <span class="mb-1 block font-display text-label-sm tracking-widest text-primary uppercase">
        {eyebrow}
      </span>
    )}
    <Heading
      id={id}
      class="text-headline-lg-mobile tracking-wide text-on-surface uppercase md:text-headline-lg"
    >
      {title}
    </Heading>
  </div>
  {href && linkLabel && (
    <a
      href={href}
      class="group flex max-w-[7rem] shrink-0 items-center gap-1 text-right font-display text-label-md tracking-wider text-tertiary uppercase transition-colors hover:text-primary md:max-w-none md:text-label-lg"
    >
      {linkLabel}
      <span
        class="material-symbols-outlined transition-transform group-hover:translate-x-1"
        aria-hidden="true"
      >
        arrow_forward
      </span>
    </a>
  )}
</div>
