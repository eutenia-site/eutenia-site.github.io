---
import BrandIcon from './ui/BrandIcon.astro';

interface Props {
  id: string;
  title: string;
  options: {
    key: 'spotify' | 'appleMusic' | 'deezer' | 'tidal' | 'youtubeMusic';
    label: string;
    href: string;
  }[];
}

const { id, title, options } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  data-streaming-dialog
  class="fixed inset-0 m-auto max-h-[85dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto border border-tertiary-container/30 bg-surface-container-low p-6 text-on-surface shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm"
>
  <div class="mb-5 flex items-start justify-between gap-4">
    <div>
      <h2 id={`${id}-title`} class="font-display text-headline-sm uppercase">
        Ouvir {title}
      </h2>
      <p class="mt-2 text-body-sm text-tertiary">
        Escolha a plataforma. O link abre em uma nova aba.
      </p>
    </div>
    <form method="dialog">
      <button
        autofocus
        aria-label="Fechar opções de plataformas"
        class="flex h-10 w-10 items-center justify-center border border-tertiary-container/30 text-2xl hover:text-primary"
      >
        <span aria-hidden="true">×</span>
      </button>
    </form>
  </div>
  <ul class="space-y-3">
    {options.map((option) => (
      <li>
        <a
          href={option.href}
          target="_blank"
          rel="noopener"
          class="flex min-h-12 items-center gap-3 border border-tertiary-container/30 px-4 py-3 text-body-md transition-colors hover:border-primary hover:text-primary"
        >
          <BrandIcon name={option.key} />
          {option.label}
          <span class="sr-only"> (abre em nova aba)</span>
        </a>
      </li>
    ))}
  </ul>
</dialog>
<noscript>
  <div class="mt-4 border border-tertiary-container/20 p-4">
    <p>Ouvir {title}:</p>
    {options.map((option) => (
      <a class="mr-4 inline-block py-2 underline" href={option.href} target="_blank" rel="noopener">
        {option.label}
      </a>
    ))}
  </div>
</noscript>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-listen-dialog]').forEach((trigger) => {
    const dialog = document.getElementById(
      trigger.dataset.listenDialog!,
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    trigger.addEventListener('click', (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      dialog.showModal();
      dialog.addEventListener('close', () => trigger.focus(), { once: true });
    });
  });
  document.querySelectorAll<HTMLDialogElement>('[data-streaming-dialog]').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect();
      if (
        event.target === dialog &&
        (event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom)
      )
        dialog.close();
    });
  });
</script>
