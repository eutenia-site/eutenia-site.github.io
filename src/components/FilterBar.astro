---
/**
 * Filter buttons (and an optional sort select) over the items of a list on the page.
 * Items are the element children of `target` and carry the data the rule reads:
 * - rule "kind": `data-kind` (Discografia: albuns, singles, ao-vivo, videoclipes)
 * - rule "categoria": `data-categoria` (Loja product categories)
 * - sort: `data-preco` (cents) and `data-adicionado` (ISO date)
 * `target` may match several lists (Discografia: releases and videos); a list's closest
 * `[data-filter-group]` (its section) hides while none of its items is visible.
 * Hidden without JavaScript: the list then shows every item in build order (QUAL-05).
 */
interface Props {
  /** CSS selector of the list(s) whose element children are filtered. */
  target: string;
  rule: 'kind' | 'categoria';
  /** Filters to show, "todos" first (pass them through visibleFilters). */
  filters: readonly { value: string; label: string }[];
  /** Accessible name of the button group, e.g. "Filtrar por tipo". */
  label: string;
  /** Shows "Organizar:" with Mais recentes / Menor preço / Maior preço. */
  sort?: boolean;
  /** Content shown only in the unfiltered "Todos" view, such as the featured release. */
  overviewTarget?: string;
  /** Show and announce the number of matching items and selected filter. */
  showCount?: boolean;
  class?: string;
}

const {
  target,
  rule,
  filters,
  label,
  sort = false,
  overviewTarget,
  showCount = false,
  class: className,
} = Astro.props;
const sortId = `ordem-${target.replace(/[^a-z0-9]/gi, '')}`;
---

<div
  hidden
  data-filter-bar
  data-target={target}
  data-rule={rule}
  data-overview-target={overviewTarget}
  class:list={[
    'flex flex-wrap items-center justify-between gap-4 border-b border-tertiary-container/20 pb-4',
    className,
  ]}
>
  <div role="group" aria-label={label} class="flex w-full gap-2 overflow-x-auto pb-2 lg:w-auto">
    {filters.map((f, i) => (
      <button
        type="button"
        data-filter={f.value}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class="shrink-0 border border-tertiary-container/20 bg-surface-container px-5 py-2.5 font-display text-label-md tracking-wider whitespace-nowrap text-tertiary uppercase transition-colors hover:bg-surface-container-high hover:text-on-surface aria-pressed:border-primary-container aria-pressed:bg-primary-container aria-pressed:text-void aria-pressed:shadow-glow"
      >
        {f.label}
      </button>
    ))}
  </div>
  {showCount && (
    <p
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-filter-status
      class="w-full text-left font-display text-label-sm tracking-wider text-tertiary uppercase"
    />
  )}
  {sort && (
    <div class="flex items-center gap-3">
      <label for={sortId} class="font-display text-label-sm text-tertiary uppercase">
        Organizar:
      </label>
      <select
        id={sortId}
        data-sort
        class="border border-tertiary-container/20 bg-surface-container px-3 py-1.5 font-display text-label-md text-on-surface uppercase focus:border-primary"
      >
        <option value="recentes">Mais recentes</option>
        <option value="menor-preco">Menor preço</option>
        <option value="maior-preco">Maior preço</option>
      </select>
    </div>
  )}
</div>

<script>
  import {
    filterByKind,
    filterProducts,
    sortProducts,
    type DiscFilter,
    type DiscKind,
    type ProductCategory,
    type ProductFilter,
    type ProductOrder,
  } from '../lib/catalog';

  for (const bar of document.querySelectorAll<HTMLElement>('[data-filter-bar]')) {
    const lists = [...document.querySelectorAll<HTMLElement>(bar.dataset.target!)];
    if (lists.length === 0) continue;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const select = bar.querySelector<HTMLSelectElement>('[data-sort]');
    const status = bar.querySelector<HTMLElement>('[data-filter-status]');
    const overview = bar.dataset.overviewTarget
      ? [...document.querySelectorAll<HTMLElement>(bar.dataset.overviewTarget)]
      : [];
    const items = lists.flatMap((l) =>
      [...l.children].filter((el): el is HTMLElement => el instanceof HTMLElement),
    );
    const rule = bar.dataset.rule;
    const updateCount = (count: number, button: HTMLButtonElement) => {
      if (status) {
        status.textContent = `${count} ${count === 1 ? 'resultado' : 'resultados'} · ${button.textContent?.trim()}`;
      }
    };

    const visible = (filter: string): Set<HTMLElement> => {
      if (rule === 'kind') {
        const rows = items.map((el) => ({ el, kind: el.dataset.kind as DiscKind }));
        return new Set(filterByKind(rows, filter as DiscFilter).map((r) => r.el));
      }
      const rows = items.map((el) => ({ el, categoria: el.dataset.categoria as ProductCategory }));
      return new Set(filterProducts(rows, filter as ProductFilter).map((r) => r.el));
    };

    const order = (value: ProductOrder) => {
      const rows = items.map((el) => ({
        el,
        categoria: el.dataset.categoria as ProductCategory,
        precoCentavos: Number(el.dataset.preco),
        adicionadoEm: el.dataset.adicionado ?? '',
      }));
      for (const row of sortProducts(rows, value)) row.el.parentElement!.append(row.el);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        const shown = visible(button.dataset.filter!);
        for (const el of items) el.hidden = !shown.has(el);
        for (const l of lists) {
          const group = l.closest<HTMLElement>('[data-filter-group]');
          if (!group) continue;
          const count = [...l.children].filter((el) => shown.has(el as HTMLElement)).length;
          group.hidden = count === 0;
          const counter = group.querySelector<HTMLElement>('[data-filter-count]');
          if (counter) {
            const unit = count === 1 ? counter.dataset.countOne : counter.dataset.countMany;
            counter.textContent = `${count} ${unit ?? (count === 1 ? 'resultado' : 'resultados')}`;
          }
        }
        for (const el of overview) el.hidden = button.dataset.filter !== 'todos';
        updateCount(shown.size, button);
      });
    }
    select?.addEventListener('change', () => order(select.value as ProductOrder));
    if (buttons[0]) updateCount(items.length, buttons[0]);
    bar.hidden = false;
  }
</script>
