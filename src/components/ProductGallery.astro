---
import { productImage } from '../lib/product-images';

interface Props {
  nome: string;
  imagens: readonly string[];
  opcoes?: readonly { nome: string; imagens: readonly string[] }[];
  /** Disable inside a scrolling product list so touch gestures scroll between products. */
  swipe?: boolean;
  class?: string;
}

const { nome, imagens, opcoes, swipe = true, class: className } = Astro.props;
const paths = [...new Set(imagens)];
const photos = await Promise.all(paths.map(productImage));
const options = opcoes?.map(({ nome, imagens }) => ({
  name: nome,
  photos: imagens.map((path) => photos[paths.indexOf(path)]),
}));
const first = photos[0];
if (!first) throw new Error(`Produto sem fotos: ${nome}`);
const multiple = photos.length > 1;
---

<div
  class:list={['relative aspect-[4/5] overflow-hidden bg-void select-none', className]}
  role="group"
  aria-roledescription={multiple ? 'carrossel' : undefined}
  aria-label={`Fotos de ${nome}`}
  data-product-gallery
  data-gallery-images={JSON.stringify(photos)}
  data-gallery-name={nome}
  data-gallery-options={options && JSON.stringify(options)}
  data-gallery-swipe={swipe}
  style={swipe ? 'touch-action: pan-y pinch-zoom' : undefined}
>
  <img
    src={first}
    alt={multiple ? `${nome} — foto 1 de ${photos.length}` : nome}
    width="400"
    height="500"
    loading="lazy"
    decoding="async"
    draggable="false"
    class="h-full w-full object-contain"
    data-gallery-image
  />
  {multiple && (
    <>
      <button
        type="button"
        hidden
        data-gallery-controls
        data-gallery-prev
        aria-label={`Foto anterior de ${nome}`}
        class="absolute top-1/2 left-1 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-white/20 bg-black/70 text-white backdrop-blur-sm transition-colors hover:bg-black/90"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button
        type="button"
        hidden
        data-gallery-controls
        data-gallery-next
        aria-label={`Próxima foto de ${nome}`}
        class="absolute top-1/2 right-1 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-white/20 bg-black/70 text-white backdrop-blur-sm transition-colors hover:bg-black/90"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <span
        hidden
        data-gallery-controls
        data-gallery-counter
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="absolute right-2 bottom-2 z-10 bg-black/80 px-2.5 py-1 font-body text-xs text-white"
      >
        <span class="sr-only">Foto </span>
        <span data-gallery-index>1</span>
        <span aria-hidden="true"> / </span>
        <span class="sr-only"> de </span>
        <span data-gallery-total>{photos.length}</span>
      </span>
    </>
  )}
  <slot />
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-product-gallery]')) {
    const allImages: string[] = JSON.parse(root.dataset.galleryImages ?? '[]');
    const image = root.querySelector<HTMLImageElement>('[data-gallery-image]');
    if (!image || allImages.length < 2 || root.dataset.galleryReady) continue;

    root.dataset.galleryReady = 'true';
    const counter = root.querySelector<HTMLElement>('[data-gallery-index]');
    const total = root.querySelector<HTMLElement>('[data-gallery-total]');
    const controls = root.querySelectorAll<HTMLElement>('[data-gallery-controls]');
    let images = allImages;
    let name = root.dataset.galleryName ?? '';
    let current = 0;
    const show = (index: number) => {
      current = (index + images.length) % images.length;
      image.src = images[current];
      image.alt = images.length > 1 ? `${name} — foto ${current + 1} de ${images.length}` : name;
      if (counter) counter.textContent = String(current + 1);
    };

    const updateControls = () => {
      const multiple = images.length > 1;
      root.tabIndex = multiple ? 0 : -1;
      if (multiple) root.setAttribute('aria-roledescription', 'carrossel');
      else root.removeAttribute('aria-roledescription');
      controls.forEach((control) => { control.hidden = !multiple; });
      if (total) total.textContent = String(images.length);
    };
    if (root.dataset.galleryOptions) {
      const options: { name: string; photos: string[] }[] = JSON.parse(root.dataset.galleryOptions);
      const select = root.parentElement?.querySelector<HTMLSelectElement>('[data-gallery-option]');
      const selectPhotos = () => {
        const option = options[Number.parseInt(select?.value ?? '', 10)];
        images = option?.photos ?? allImages;
        name = option ? `${root.dataset.galleryName} — ${option.name}` : (root.dataset.galleryName ?? '');
        root.setAttribute('aria-label', `Fotos de ${name}`);
        updateControls();
        show(0);
      };
      select?.addEventListener('change', selectPhotos);
      selectPhotos();
    } else {
      updateControls();
    }
    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
    root.addEventListener('keydown', (event) => {
      if (images.length < 2 || event.altKey || event.ctrlKey || event.metaKey) return;
      switch (event.key) {
        case 'ArrowLeft':
          event.preventDefault();
          show(current - 1);
          break;
        case 'ArrowRight':
          event.preventDefault();
          show(current + 1);
          break;
        case 'Home':
          event.preventDefault();
          show(0);
          break;
        case 'End':
          event.preventDefault();
          show(images.length - 1);
          break;
      }
    });

    let start: { x: number; y: number; id: number } | undefined;
    root.addEventListener('pointerdown', (event) => {
      if (
        images.length < 2 ||
        root.dataset.gallerySwipe === 'false' ||
        event.pointerType !== 'touch' ||
        (event.target as Element).closest('button')
      )
        return;
      start = { x: event.clientX, y: event.clientY, id: event.pointerId };
      try {
        root.setPointerCapture(event.pointerId);
      } catch {
        // Navigation still works if the browser cannot capture this pointer.
      }
    });
    root.addEventListener('pointerup', (event) => {
      if (!start || event.pointerId !== start.id) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      start = undefined;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.25) {
        show(current + (dx < 0 ? 1 : -1));
      }
    });
    root.addEventListener('pointercancel', () => {
      start = undefined;
    });
  }
</script>
