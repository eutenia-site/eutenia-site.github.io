---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../../assets/brand/eutenia-logo-silver.png';
import BrandIcon from '../ui/BrandIcon.astro';
import { url } from '../../lib/paths';
import { PAGES, SOCIALS, isCurrent } from './nav';

const site = (await getEntry('site', 'site'))!.data;
const links = [...PAGES, { label: 'Política de Privacidade', path: '/privacidade/' }].map((p) => {
  const href = url(p.path);
  return { label: p.label, href, current: isCurrent(Astro.url.pathname, href) };
});
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-tertiary-container/15 bg-surface-container-lowest">
  <div class="mx-auto flex w-full max-w-[1440px] flex-col px-margin-sm py-space-xl md:px-margin xl:px-margin-lg">
    <div class="mb-8 grid grid-cols-1 items-start gap-8 border-b border-tertiary-container/10 pb-8 lg:grid-cols-[12rem_minmax(0,1fr)_12rem] lg:items-center">
      <a href={url('/')} class="flex shrink-0 items-center">
        <Image
          src={logo}
          alt="Eutenia"
          width={384}
          loading="lazy"
          class="block h-16 w-48 object-cover"
        />
      </a>
      <nav aria-label="Rodapé" class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-center">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'font-display text-label-md tracking-wider uppercase transition-colors duration-150 hover:text-primary',
              l.current ? 'text-primary' : 'text-tertiary',
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col items-start justify-between gap-6 text-body-sm text-tertiary md:flex-row md:items-center">
      <p>
        © {year} Eutenia. Todos os direitos reservados. Contato:{' '}
        <a
          href={`mailto:${site.email}`}
          class="underline-offset-2 transition-colors hover:text-primary hover:underline"
        >
          {site.email}
        </a>
      </p>
      <ul class="flex items-center gap-1 sm:gap-3" aria-label="Redes sociais">
        {SOCIALS.map((s) => (
          <li>
            <a
              href={site.social[s.key]}
              target="_blank"
              rel="noopener"
              class="laser-border flex h-9 w-9 items-center justify-center text-tertiary transition-all hover:border-crimson hover:text-primary"
              aria-label={`Eutenia no ${s.label}`}
              title={s.label}
            >
              <BrandIcon name={s.key} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
