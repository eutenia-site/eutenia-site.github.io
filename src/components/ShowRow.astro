---
import type { CollectionEntry } from 'astro:content';
import Badge from './ui/Badge.astro';
import { formatShowDate, isoDay, showWeekday } from '../lib/format';

interface Props {
  show: CollectionEntry<'shows'>['data'];
  /** Instagram profile, the target of "AVISE-ME" (Q24). */
  instagram: string;
  /** home: compact row of the Início teaser; agenda: full row of the Shows page. */
  variant?: 'home' | 'agenda';
  hidden?: boolean;
}

const { show, instagram, variant = 'agenda', hidden = false } = Astro.props;
const { dia, mes, ano } = formatShowDate(show.data);
const semana = showWeekday(show.data);
const home = variant === 'home';

const STATUS = {
  disponivel: { label: 'Ingressos disponíveis', tone: 'neutral' },
  ultimos: { label: 'Últimos ingressos', tone: 'alert' },
  esgotado: { label: 'Esgotado', tone: 'muted' },
  'em-breve': { label: 'Em breve', tone: 'neutral' },
} as const;
const status = STATUS[show.status];
// SPEC_DEVIATION: the Início desktop capture draws "Ingressos"; SHOW-07 names the action
// "Comprar ingresso", so every row uses the spec's label (visible text = accessible name).
const buyLabel = 'Comprar ingresso';
const onSale = (show.status === 'disponivel' || show.status === 'ultimos') && !!show.ingressoUrl;
const place = `${show.cidade}, ${show.uf}`;
// Below md the row is one compact line: date | status, place, venue | action (mobile-shows.png).
const actionBase =
  'col-start-3 row-span-4 row-start-1 inline-flex max-w-[8.5rem] shrink-0 items-center justify-center gap-2 self-center px-3 py-2 text-center font-display text-label-md tracking-wider uppercase transition-all md:max-w-none md:px-6 md:py-2.5 md:text-label-lg';
---

<li
  data-show
  data-show-id={show.id}
  data-date={isoDay(show.data)}
  data-cidade={show.cidade}
  data-tipo={show.tipo}
  data-status={show.status}
  hidden={hidden}
  class:list={[
    'group relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 bg-surface-container-low py-3 pr-3 pl-4 laser-border laser-border-hover transition-all duration-150 md:flex md:flex-row md:justify-between md:gap-4 md:p-6',
    show.status === 'esgotado' && !home && 'opacity-70',
  ]}
>
  <span
    class:list={[
      'absolute top-0 bottom-0 left-0 w-1 transition-colors group-hover:bg-crimson',
      onSale ? 'bg-crimson md:bg-transparent' : 'bg-transparent',
    ]}
    aria-hidden="true"
  ></span>
  <div class="contents md:flex md:items-center md:gap-6">
    <div class="col-start-1 row-span-4 row-start-1 w-14 shrink-0 self-center border border-tertiary-container/20 bg-surface-container py-1.5 text-center md:w-20 md:border-0 md:border-r md:bg-transparent md:py-0 md:pr-4">
      <span class="block font-display text-headline-sm leading-none font-bold text-on-surface md:text-headline-md">
        {dia}
      </span>
      <span class="font-display text-label-sm tracking-widest whitespace-nowrap text-primary uppercase">
        {mes}
        {home && <span class="hidden md:inline">{` • ${semana}`}</span>}
      </span>
      {!home && <span class="block font-display text-label-sm text-tertiary">{ano}</span>}
      <span class="sr-only">{`de ${ano}`}</span>
    </div>
    <div class="contents md:block md:min-w-0">
      {home ? (
        <>
          <p
            class="col-start-2 row-start-2 font-display text-title-md font-bold text-on-surface"
            data-show-place
          >
            {place}
          </p>
          <p class="col-start-2 row-start-3 flex items-center gap-1 text-body-sm text-tertiary">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">
              location_on
            </span>
            {show.local}
          </p>
        </>
      ) : (
        <>
          <div class="col-start-2 row-start-2 flex flex-wrap items-center gap-2 md:mb-1">
            <span
              class="font-display text-label-sm tracking-widest text-primary uppercase"
              data-show-place
            >
              {place}
            </span>
            {show.selo && <Badge tone="alert">{show.selo}</Badge>}
          </div>
          <h3 class="col-start-2 row-start-3 font-display text-title-md tracking-wide text-on-surface uppercase md:text-headline-sm">
            {show.local}
          </h3>
          <p class="col-start-2 row-start-4 flex items-start gap-1 text-body-sm text-tertiary md:mt-1">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">
              location_on
            </span>
            {show.endereco}
          </p>
        </>
      )}
    </div>
  </div>
  <div class="contents md:flex md:w-auto md:shrink-0 md:items-center md:justify-end md:gap-5">
    <Badge tone={status.tone} class="col-start-2 row-start-1 justify-self-start">
      {status.label}
    </Badge>
    {home && show.selo && (
      <span class="hidden lg:contents">
        <Badge>{show.selo}</Badge>
      </span>
    )}
    {onSale ? (
      <a
        href={show.ingressoUrl}
        target="_blank"
        rel="noopener"
        data-show-action
        aria-label={`${buyLabel}: ${place}, ${dia}/${mes}/${ano} (abre em nova aba)`}
        class:list={[actionBase, 'bg-crimson text-void hover:bg-primary-container red-glow']}
      >
        {buyLabel}
        {!home && (
          <span class="material-symbols-outlined hidden text-base md:inline" aria-hidden="true">
            arrow_outward
          </span>
        )}
      </a>
    ) : show.status === 'esgotado' ? (
      <button
        type="button"
        disabled
        data-show-action
        class:list={[actionBase, 'cursor-not-allowed bg-surface-container-highest text-tertiary']}
      >
        Esgotado
      </button>
    ) : (
      <a
        href={instagram}
        target="_blank"
        rel="noopener"
        data-show-action
        aria-label={`Avise-me: ${place}, ${dia}/${mes}/${ano} (Instagram, abre em nova aba)`}
        class:list={[actionBase, 'border border-silver text-silver hover:bg-chrome/10']}
      >
        <span class="material-symbols-outlined hidden text-base md:inline" aria-hidden="true">
          notifications
        </span>
        Avise-me
      </a>
    )}
  </div>
</li>
