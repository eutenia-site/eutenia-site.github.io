---
import '../styles/global.css';
import BottomBar from '../components/layout/BottomBar.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { getCollection } from 'astro:content';
import { CODE_ICONS, iconFontUrl } from '../lib/icons';
import { url } from '../lib/paths';

interface Props {
  /** Page title; the layout prefixes "Eutenia | " unless it is the home title. */
  title: string;
  description: string;
  /** Public path of the share image (defaults to the hero photo). */
  image?: string;
  /** Error pages (404) have no address of their own: no canonical, og:url or indexing. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = 'placeholders/fotos/hero-palco.jpg',
  noindex = false,
} = Astro.props;
const dataIcons = [...(await getCollection('press')), ...(await getCollection('fanKit'))].map(
  (e) => e.data.icone,
);
const iconFont = iconFontUrl([...CODE_ICONS, ...dataIcons]);
const textFonts =
  'https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap';
const fullTitle = title === 'Eutenia' ? title : `Eutenia | ${title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(url(image), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={url('favicon.svg')} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a0b0e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Eutenia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint (QUAL-04). Text fonts: display=swap shows
         the fallback until they arrive. Icons: each holds a 1em box and stays hidden until
         its stylesheet is in, so ligature names never flash and nothing shifts. -->
    <link
      rel="preload"
      as="style"
      href={textFonts}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      rel="preload"
      as="style"
      href={iconFont}
      onload="this.onload=null;this.rel='stylesheet';document.documentElement.classList.add('icons-ready')"
    />
    <noscript>
      <link rel="stylesheet" href={textFonts} />
      <link rel="stylesheet" href={iconFont} />
      <style>
        .material-symbols-outlined {
          visibility: visible !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col pb-20 md:pb-0">
    <a
      href="#conteudo"
      class="sr-only z-[100] bg-crimson px-4 py-2 font-display text-label-lg text-white uppercase focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <BottomBar />
  </body>
</html>
